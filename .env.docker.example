# Copy to `.env` (same folder as docker-compose.yml). NEVER commit the real file.
MONGO_PASSWORD=change-me-strong-password
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=generate-a-different-one-with-openssl-rand-hex-48
CLIENT_ORIGIN=http://localhost:5000
APP_PORT=5000
# Set to 1 when running behind ONE reverse proxy (nginx, Render, Fly, Cloudflare...)
TRUST_PROXY=0
COMPANY_TZ=Asia/Kolkata
