{
  "info": {
    "name": "StaffSync API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.accessToken) pm.collectionVariables.set('accessToken', r.accessToken);"] } }],
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"hr@staffsync.test\",\"password\":\"Passw0rd!23\"}" }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{base}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Refresh",
          "request": { "method": "POST", "url": "{{base}}/auth/refresh" }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/change-password",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"currentPassword\":\"Passw0rd!23\",\"newPassword\":\"NewPass1!\"}" }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{base}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "url": "{{base}}/departments",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Department",
          "request": {
            "method": "GET",
            "url": "{{base}}/departments/{{deptId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "url": "{{base}}/departments",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Marketing\",\"code\":\"MKT\",\"description\":\"Marketing and branding department\"}"
            }
          }
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "url": "{{base}}/departments/{{deptId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Updated description\"}"
            }
          }
        },
        {
          "name": "Delete Department",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/departments/{{deptId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List Employees (Paginated / Filtered)",
          "request": {
            "method": "GET",
            "url": "{{base}}/employees?page=1&limit=10&status=active",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Colleague Directory (All Roles)",
          "request": {
            "method": "GET",
            "url": "{{base}}/employees/directory",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "My Team (Manager)",
          "request": {
            "method": "GET",
            "url": "{{base}}/employees/team",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Employee Details",
          "request": {
            "method": "GET",
            "url": "{{base}}/employees/{{empId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Employee (HR)",
          "request": {
            "method": "POST",
            "url": "{{base}}/employees",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Alex Morgan\",\"email\":\"alex@staffsync.test\",\"role\":\"employee\",\"department\":\"{{deptId}}\",\"designation\":\"Analyst\"}"
            }
          }
        },
        {
          "name": "Update Employee (HR)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/employees/{{empId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"designation\":\"Senior Analyst\"}"
            }
          }
        },
        {
          "name": "Update Self Profile (All Roles)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/employees/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"555-0199\",\"address\":\"42 Enterprise Way\"}"
            }
          }
        },
        {
          "name": "Update Employee Status (HR)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/employees/{{empId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"inactive\"}"
            }
          }
        },
        {
          "name": "Reset Employee Password (HR)",
          "request": {
            "method": "POST",
            "url": "{{base}}/employees/{{empId}}/reset-password",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Leave Types",
      "item": [
        {
          "name": "Get All Leave Types",
          "request": {
            "method": "GET",
            "url": "{{base}}/leave-types",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Leave Type (HR)",
          "request": {
            "method": "POST",
            "url": "{{base}}/leave-types",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Maternity Leave\",\"code\":\"MATERNITY\",\"annualQuota\":90,\"isPaid\":true,\"isUnlimited\":false,\"isActive\":true}"
            }
          }
        },
        {
          "name": "Update Leave Type (HR)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/leave-types/{{leaveTypeId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"annualQuota\":15}"
            }
          }
        },
        {
          "name": "Delete Leave Type (HR)",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/leave-types/{{leaveTypeId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Holidays",
      "item": [
        {
          "name": "Get Holidays (?year=)",
          "request": {
            "method": "GET",
            "url": "{{base}}/holidays?year=2026",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Holiday (HR)",
          "request": {
            "method": "POST",
            "url": "{{base}}/holidays",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Diwali\",\"date\":\"2026-11-08\"}"
            }
          }
        },
        {
          "name": "Update Holiday (HR)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/holidays/{{holidayId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Deepavali Festival\"}"
            }
          }
        },
        {
          "name": "Delete Holiday (HR)",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/holidays/{{holidayId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Leaves",
      "item": [
        {
          "name": "Preview Working Days Live",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/preview?startDate=2026-11-06&endDate=2026-11-10&halfDay=false",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Own Leave Balances",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/balances?year=2026",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get User Balances (HR / Manager Team)",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/balances/{{userId}}?year=2026",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Adjust Leave Quota (HR)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/leaves/balances/{{balanceId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"allocated\":16,\"reason\":\"Annual policy adjustment\"}"
            }
          }
        },
        {
          "name": "Apply for Leave",
          "request": {
            "method": "POST",
            "url": "{{base}}/leaves",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"leaveType\":\"{{leaveTypeId}}\",\"startDate\":\"2026-11-16\",\"endDate\":\"2026-11-18\",\"halfDay\":false,\"reason\":\"Vacation with family\"}"
            }
          }
        },
        {
          "name": "Get My Leave History",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/my?year=2026&page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Pending Approvals (Manager / HR)",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/pending-approvals",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get All Leaves (HR / Manager Team)",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves?status=pending&page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Leave By ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/{{leaveId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Decide Leave (Approve/Reject)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/leaves/{{leaveId}}/decision",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"decision\":\"approved\",\"note\":\"Approved for vacation\"}"
            }
          }
        },
        {
          "name": "Cancel Leave Request",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/leaves/{{leaveId}}/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Leave & Holiday Calendar (?month=YYYY-MM)",
          "request": {
            "method": "GET",
            "url": "{{base}}/leaves/calendar?month=2026-11",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    }
  ]
}
