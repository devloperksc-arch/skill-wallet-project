          "name": "My Enrollments (Employee)",
          "request": {
            "method": "GET",
            "url": "{{base}}/training/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Update Enrollment Progress / Feedback (Employee)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/training/enrollments/{{enrollmentId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"progress\":50,\"feedback\":\"Great hands-on labs and examples!\"}"
            }
          }
        },
        {
          "name": "Record Score & Complete Enrollment (Manager)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/training/enrollments/{{enrollmentId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"score\":92,\"managerNote\":\"Excellent mastery demonstrated.\",\"status\":\"completed\"}"
            }
          }
        },
        {
          "name": "Training Summary Reports (Manager & HR)",
          "request": {
            "method": "GET",
            "url": "{{base}}/training/reports/summary",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Delete Training Program (Manager - Draft only)",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/training/{{trainingId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    }
  ]
}
